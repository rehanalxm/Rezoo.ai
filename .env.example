# ============================================
# REZOO AI ASSISTANT - ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================

# --- Groq (100% FREE & Ultra Fast - Recommended) ---
# Get your free key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-free-groq-key-here
GROQ_MODEL=qwen/qwen3.8-27b

# --- OpenAI (Alternative) ---
# OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Picovoice (Optional - for "Hey Rezoo" wake word) ---
# Get your free access key from: https://picovoice.ai
# Without this, use click-to-talk instead
PICOVOICE_ACCESS_KEY=your-picovoice-access-key-here

# --- MongoDB (Optional - defaults to local) ---
# Local: mongodb://localhost:27017/rezoo
# Atlas free tier: https://mongodb.com/cloud/atlas
MONGODB_URI=mongodb://localhost:27017/rezoo

# --- Server ---
PORT=3001
WS_PORT=3001

# --- Optional: Custom voice ---
# OpenAI TTS voice: alloy, echo, fable, onyx, nova, shimmer
TTS_VOICE=nova
